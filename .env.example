# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key
MAX_CONTENT_LENGTH=52428800  # 50 MB in bytes

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=clouddedup_db
MYSQL_USER=root
MYSQL_PASSWORD=""

# Firebase Cloud Storage & Admin SDK Configuration
FIREBASE_PROJECT_ID=clouddedup-project
FIREBASE_STORAGE_BUCKET=clouddedup-project.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Development / Demonstration Mode (Optional: set to 1 for offline testing/demo if MySQL or Firebase credentials are not yet configured)
DEV_MODE=0
